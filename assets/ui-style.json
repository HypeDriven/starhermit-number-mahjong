    ".page": {
      "background": [
        {
          "type": "radial",
          "center": {
            "x": 0.5,
            "y": -0.1
          },
          "stops": [
            "#e8b34b1f",
            {
              "color": "#e8b34b00",
              "at": 0.55
            }
          ]
        },
        "$bg"
      ],
      "radius": 0
