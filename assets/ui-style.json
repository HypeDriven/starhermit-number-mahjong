    ".page-plain": {
      "background": "$bg",
      "radius": 0
    },
    ".title-art": {
      "background": [
        {
          "type": "linear",
          "stops": [
            "#171a248c",
            {
              "color": "#171a24",
              "at": 0.62
            }
          ]
        },
        {
          "image": "assets/title-backdrop.webp",
          "size": "cover",
          "position": {
            "x": 0.5,
            "y": 0
          },
          "repeat": true
        },
        "$bg"
      ],
      "radius": 0
    },
    ".results-art": {
      "background": [
        {
          "type": "linear",
          "stops": [
            {
              "color": "#00000000",
              "at": 0.62
            },
            "$bg"
          ]
        },
        {
          "image": "assets/tile-stack.webp",
          "size": "cover",
          "position": {
            "x": 0.5,
            "y": 0.62
